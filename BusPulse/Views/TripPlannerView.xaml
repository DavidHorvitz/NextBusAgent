<UserControl x:Class="BusPulse.Views.TripPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:BusPulse.Views"
             xmlns:controls="clr-namespace:BusPulse.Views.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshNowCommand}" />
  </UserControl.InputBindings>
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:IndexToBoolConverter x:Key="IndexToBool" />
    <views:CountToVisibilityConverter x:Key="CountToVisibility" />
    <!-- A suggestion list is a plain stack of rows under its box: no border or card of its own. -->
    <Style x:Key="SuggestionList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MaxHeight" Value="280" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <DataTemplate x:Key="SuggestionTemplate">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Bp.Type.Caption}" Margin="12,0,0,0" VerticalAlignment="Center"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
      </Grid>
    </DataTemplate>
    <Style x:Key="HiddenWhenEmptyText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Bp.Text.Secondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8,0,16,16">
      <!-- Calendar suggestions: a quiet block, no card of its own. -->
      <StackPanel Margin="0,0,0,16" Visibility="{Binding CalendarSuggestions.Count, Converter={StaticResource CountToVisibility}}">
        <TextBlock Text="{DynamicResource CalendarSuggestionsTitle}" Style="{StaticResource Bp.Type.BodyStrong}" Foreground="{DynamicResource Bp.Accent.11}" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding CalendarSuggestions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Bp.Type.Body}" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StartText}" Style="{StaticResource Bp.Type.Caption}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding PlaceName}" Style="{StaticResource Bp.Type.Caption}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource CalendarSuggestionUse}" Style="{StaticResource Bp.Button.Secondary}" Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding DataContext.UseCalendarSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel>
          <!-- Origin: free text. Suggestions: my location, saved places, calendar, recent, stops, addresses (DESIGN.md, suggestion row). -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource StartPlaceLabel}" Style="{StaticResource Bp.Type.Caption}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource Bp.Button.Icon}" Command="{Binding SwapCommand}"
                    ToolTip="{DynamicResource SwapRoutes}" AutomationProperties.Name="{DynamicResource SwapRoutes}">
              <ui:SymbolIcon Symbol="ArrowSwap24" />
            </Button>
          </Grid>
          <Grid Margin="0,4,0,0">
            <TextBox x:Name="OriginSearchBox" Style="{StaticResource Bp.TextBox}" Text="{Binding OriginQuery, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="64" Padding="8,4,8,4" AutomationProperties.Name="{DynamicResource StartPlaceLabel}"
                     PreviewKeyDown="OriginSearchBox_PreviewKeyDown" GotKeyboardFocus="OriginSearchBox_GotKeyboardFocus"
                     LostKeyboardFocus="OriginSearchBox_LostKeyboardFocus" />
            <TextBlock Text="{DynamicResource OriginPlaceholder}" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="10,0,10,0" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Bp.Type.Caption}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding OriginQuery}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Margin="4,0,4,1" AutomationProperties.Name="{DynamicResource SearchingAddress}"
                         Visibility="{Binding IsOriginSearching, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
          <ListBox x:Name="OriginSuggestionList" Style="{StaticResource SuggestionList}" ItemTemplate="{StaticResource SuggestionTemplate}"
                   ItemContainerStyle="{StaticResource Bp.SuggestionRow}" ItemsSource="{Binding OriginSuggestions}"
                   SelectedItem="{Binding HighlightedOrigin, Mode=TwoWay}" Focusable="False"
                   Visibility="{Binding OriginSuggestions.Count, Converter={StaticResource CountToVisibility}}"
                   PreviewMouseLeftButtonUp="OriginSuggestionList_PreviewMouseLeftButtonUp"
                   AutomationProperties.Name="{DynamicResource StartPlaceLabel}" />
          <TextBlock Text="{DynamicResource NoResultsLine}" Style="{StaticResource Bp.Type.Hint}" Margin="8,6,8,0"
                     Visibility="{Binding OriginNoResults, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding OriginSearchMessage}" Style="{StaticResource HiddenWhenEmptyText}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="{DynamicResource SavePlace}" Command="{Binding SaveOriginCommand}" Style="{StaticResource Bp.Button.Quiet}" Margin="0,0,8,0"
                    Visibility="{Binding CanSaveOrigin, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{DynamicResource SaveAsHome}" Command="{Binding SaveOriginCommand}" CommandParameter="home" Style="{StaticResource Bp.Button.Quiet}" Margin="0,0,8,0"
                    Visibility="{Binding CanSaveOrigin, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{DynamicResource SaveAsWork}" Command="{Binding SaveOriginCommand}" CommandParameter="work" Style="{StaticResource Bp.Button.Quiet}"
                    Visibility="{Binding CanSaveOrigin, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <TextBlock Text="{DynamicResource DestinationPlaceLabel}" Style="{StaticResource Bp.Type.Caption}" Margin="0,16,0,0" />
          <Grid Margin="0,4,0,0">
            <TextBox x:Name="SearchBox" Style="{StaticResource Bp.TextBox}" Text="{Binding DestinationQuery, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="64" Padding="8,4,8,4" AutomationProperties.Name="{DynamicResource DestinationPlaceLabel}"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                     LostKeyboardFocus="SearchBox_LostKeyboardFocus" />
            <TextBlock Text="{DynamicResource DestinationPlaceholder}" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="10,0,10,0" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Bp.Type.Caption}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DestinationQuery}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Margin="4,0,4,1" AutomationProperties.Name="{DynamicResource SearchingAddress}"
                         Visibility="{Binding IsDestinationSearching, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
          <ListBox x:Name="SuggestionList" Style="{StaticResource SuggestionList}" ItemTemplate="{StaticResource SuggestionTemplate}"
                   ItemContainerStyle="{StaticResource Bp.SuggestionRow}" ItemsSource="{Binding Suggestions}"
                   SelectedItem="{Binding HighlightedDestination, Mode=TwoWay}" Focusable="False"
                   Visibility="{Binding Suggestions.Count, Converter={StaticResource CountToVisibility}}"
                   PreviewMouseLeftButtonUp="SuggestionList_PreviewMouseLeftButtonUp"
                   AutomationProperties.Name="{DynamicResource DestinationPlaceLabel}" />
          <TextBlock Text="{DynamicResource NoResultsLine}" Style="{StaticResource Bp.Type.Hint}" Margin="8,6,8,0"
                     Visibility="{Binding DestinationNoResults, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding DestinationSearchMessage}" Style="{StaticResource HiddenWhenEmptyText}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="{DynamicResource GoHome}" Command="{Binding GoHomeCommand}" Style="{StaticResource Bp.Button.Secondary}" Margin="0,0,8,0"
                    Visibility="{Binding HasHome, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{DynamicResource GoWork}" Command="{Binding GoWorkCommand}" Style="{StaticResource Bp.Button.Secondary}" Margin="0,0,8,0"
                    Visibility="{Binding HasWork, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{DynamicResource SavePlace}" Command="{Binding SaveDestinationCommand}" Style="{StaticResource Bp.Button.Quiet}" Margin="0,0,8,0"
                    Visibility="{Binding CanSaveDestination, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{DynamicResource SaveAsHome}" Command="{Binding SaveDestinationCommand}" CommandParameter="home" Style="{StaticResource Bp.Button.Quiet}" Margin="0,0,8,0"
                    Visibility="{Binding CanSaveDestination, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{DynamicResource SaveAsWork}" Command="{Binding SaveDestinationCommand}" CommandParameter="work" Style="{StaticResource Bp.Button.Quiet}"
                    Visibility="{Binding CanSaveDestination, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <TextBlock Text="{Binding RouteSummary}" Style="{StaticResource Bp.Type.BodyStrong}" Margin="0,16,0,0" TextWrapping="Wrap" />

          <!-- When: mode chips, quick chips, time fields, date chips. -->
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <RadioButton Style="{StaticResource Bp.ToggleChip}" Content="{DynamicResource ModeNow}" GroupName="TripMode" Margin="0,0,8,0"
                         IsChecked="{Binding SelectedModeIndex, Converter={StaticResource IndexToBool}, ConverterParameter=0}" />
            <RadioButton Style="{StaticResource Bp.ToggleChip}" Content="{DynamicResource ModeDepartAt}" GroupName="TripMode" Margin="0,0,8,0"
                         IsChecked="{Binding SelectedModeIndex, Converter={StaticResource IndexToBool}, ConverterParameter=1}" />
            <RadioButton Style="{StaticResource Bp.ToggleChip}" Content="{DynamicResource ModeArriveBy}" GroupName="TripMode"
                         IsChecked="{Binding SelectedModeIndex, Converter={StaticResource IndexToBool}, ConverterParameter=2}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{DynamicResource TimeQuickLabel}" Style="{StaticResource Bp.Type.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Style="{StaticResource Bp.Button.Secondary}" Command="{Binding AddMinutesCommand}" CommandParameter="10" Margin="0,0,8,0" Content="+10" AutomationProperties.Name="+10" />
            <Button Style="{StaticResource Bp.Button.Secondary}" Command="{Binding AddMinutesCommand}" CommandParameter="20" Margin="0,0,8,0" Content="+20" AutomationProperties.Name="+20" />
            <Button Style="{StaticResource Bp.Button.Secondary}" Command="{Binding AddMinutesCommand}" CommandParameter="30" Margin="0,0,8,0" Content="+30" AutomationProperties.Name="+30" />
            <Button Style="{StaticResource Bp.Button.Secondary}" Command="{Binding AddMinutesCommand}" CommandParameter="60" Content="+60" AutomationProperties.Name="+60" />
          </StackPanel>
          <StackPanel Visibility="{Binding IsTimeSelectable, Converter={StaticResource BoolToVisibility}}" controls:Motion.FadeInOnShow="True">
            <controls:TimeFieldPicker Value="{Binding TargetTime, Mode=TwoWay}" HorizontalAlignment="Left" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <ToggleButton Style="{StaticResource Bp.ToggleChip}" Content="{DynamicResource DateToday}" IsChecked="{Binding IsTodaySelected, Mode=TwoWay}" Margin="0,0,8,0"
                            AutomationProperties.Name="{DynamicResource DateToday}" />
              <ToggleButton Style="{StaticResource Bp.ToggleChip}" Content="{DynamicResource DateTomorrow}" IsChecked="{Binding IsTomorrowSelected, Mode=TwoWay}" Margin="0,0,8,0"
                            AutomationProperties.Name="{DynamicResource DateTomorrow}" />
              <ToggleButton Style="{StaticResource Bp.ToggleChip}" Content="{Binding DatePickText}" IsChecked="{Binding IsOtherDateSelected, Mode=OneWay}" Command="{Binding ToggleDatePickerCommand}"
                            AutomationProperties.Name="{DynamicResource DatePick}" />
            </StackPanel>
            <DatePicker DisplayDateStart="{Binding MinDate, Mode=OneWay}" DisplayDateEnd="{Binding MaxDate, Mode=OneWay}" SelectedDate="{Binding TargetDate, Mode=TwoWay}"
                        HorizontalAlignment="Left" MinWidth="160" Margin="0,8,0,0" AutomationProperties.Name="{DynamicResource DateLabel}"
                        Visibility="{Binding IsDatePickerOpen, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding DateNotice}" Style="{StaticResource Bp.Type.Hint}" Foreground="{DynamicResource Bp.Warning.11}" Margin="0,8,0,0"
                       Visibility="{Binding HasDateNotice, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <!-- Optional line filter. Suggestions come from lines already seen: no network, no spinner. -->
          <TextBlock Text="{DynamicResource PreferredLineLabel}" Style="{StaticResource Bp.Type.Caption}" Margin="0,16,0,4" />
          <TextBox Style="{StaticResource Bp.TextBox}" Text="{Binding LineName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Width="160" HorizontalAlignment="Left"
                   Padding="8,4,8,4" AutomationProperties.Name="{DynamicResource PreferredLineLabel}" />
          <StackPanel Margin="0,8,0,0" Visibility="{Binding LineSuggestions.Count, Converter={StaticResource CountToVisibility}}">
            <TextBlock Text="{DynamicResource LinesFoundLabel}" Style="{StaticResource Bp.Type.Caption}" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding LineSuggestions}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource Bp.Button.Secondary}" Content="{Binding}" Margin="0,0,8,8"
                          Command="{Binding DataContext.UseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Button Content="{DynamicResource PlanTrip}" Command="{Binding PlanCommand}" Style="{StaticResource Bp.Button.Primary}" HorizontalAlignment="Left" Margin="0,16,0,0" IsDefault="True" />
          <ProgressBar IsIndeterminate="True" Height="2" Margin="0,8,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}"
                       AutomationProperties.Name="{DynamicResource Planning}" />
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource Bp.Type.Hint}" Margin="0,8,0,0" />
      </StackPanel>

      <!-- Results: one DepartureRow per direct trip. Rows are updated in place by the view model; nothing is rebuilt on a refresh. -->
      <Grid Margin="0,16,0,4" Visibility="{Binding Options.Count, Converter={StaticResource CountToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="{DynamicResource Bp.Warning.11}" Margin="0,0,6,0" VerticalAlignment="Center"
                         Visibility="{Binding IsUpdateStale, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding UpdatedAgoText}" Style="{StaticResource Bp.Type.Caption}" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource Bp.Button.Icon}" Command="{Binding RefreshNowCommand}"
                ToolTip="{DynamicResource RefreshNow}" AutomationProperties.Name="{DynamicResource RefreshNow}">
          <ui:SymbolIcon Symbol="ArrowClockwise24" />
        </Button>
      </Grid>
      <ItemsControl ItemsSource="{Binding Options}" Focusable="False" Grid.IsSharedSizeScope="True" Margin="0,0,16,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Bp.DepartureRow}" ToolTip="{Binding Tooltip}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Badge" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Status" />
                  <ColumnDefinition Width="{StaticResource Bp.EtaColumnWidth}" />
                </Grid.ColumnDefinitions>
                <controls:LineBadge LineName="{Binding Line}" OperatorName="{Binding Operator}" RouteColor="{Binding RouteColor}" VerticalAlignment="Top" Margin="0,4,0,0" />
                <StackPanel Grid.Column="1" Margin="16,2,8,2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding BoardingStop}" Style="{StaticResource Bp.Type.BodyStrong}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding LeaveByText}" Style="{StaticResource Bp.Type.Title}" Foreground="{DynamicResource Bp.Accent.11}" />
                  <TextBlock Text="{Binding WalkToLegText}" Style="{StaticResource Bp.Type.Caption}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding WalkFromLegText}" Style="{StaticResource Bp.Type.Caption}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ArriveText}" Style="{StaticResource Bp.Type.Caption}" />
                  <TextBlock Text="{Binding DateText}" Style="{StaticResource HiddenWhenEmptyText}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,4,0,0">
                  <controls:StatusChip Status="{Binding Status}" Text="{Binding BadgeText}" HorizontalAlignment="Left" />
                  <Button Style="{StaticResource Bp.Button.Quiet}" HorizontalAlignment="Left" Margin="0,4,0,0" ToolTip="{DynamicResource RemindMe}"
                          AutomationProperties.Name="{DynamicResource RemindMe}"
                          Command="{Binding DataContext.ToggleReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <ui:SymbolIcon FontSize="16">
                      <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                          <Setter Property="Symbol" Value="Alert24" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWatched}" Value="True">
                              <Setter Property="Symbol" Value="AlertOn24" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                  </Button>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0">
                  <controls:TickerText Text="{Binding EtaValue}" Style="{StaticResource Bp.Eta.Number}" />
                  <TextBlock Text="{Binding EtaUnit}" Style="{StaticResource Bp.Eta.Unit}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
