<Window x:Class="BusPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BusPulse" Height="700" Width="960" MinHeight="600" MinWidth="800"
        Background="{DynamicResource SurfaceBrush}" WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="BusPulse" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource DashboardSubtitle}" Foreground="#52615E" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="LanguageButton" Content="עברית" Padding="12,7" Margin="0,0,8,0" Click="LanguageButton_Click" />
        <Button Content="{DynamicResource MinimizeToTray}" Padding="12,7" Click="MinimizeButton_Click" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="White" BorderBrush="#DCE5E2" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{DynamicResource ActiveProfile}" Foreground="#52615E" />
          <TextBlock x:Name="ProfileText" Text="Default" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
        </StackPanel>
        <Button x:Name="MuteButton" Grid.Column="1" Content="{DynamicResource MuteNotifications}" Padding="14,8" VerticalAlignment="Center" Click="MuteButton_Click" />
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="0.85*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" BorderBrush="#DCE5E2" BorderThickness="1" CornerRadius="6" Padding="20">
        <StackPanel>
          <TextBlock Text="{DynamicResource Routes}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource StartPlaceLabel}" Foreground="#52615E" Margin="0,18,0,5" />
          <ComboBox x:Name="StartPlaceCombo" MinHeight="34" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="RouteSelection_SelectionChanged" />
          <TextBlock Text="{DynamicResource DestinationPlaceLabel}" Foreground="#52615E" Margin="0,14,0,5" />
          <ComboBox x:Name="DestinationPlaceCombo" MinHeight="34" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="RouteSelection_SelectionChanged" />
          <TextBlock Text="{DynamicResource LineNameLabel}" Foreground="#52615E" Margin="0,14,0,5" />
          <TextBox x:Name="LineNameInput" MaxLength="64" MinHeight="32" />
          <Button Content="{DynamicResource AddRoute}" HorizontalAlignment="Left" Padding="14,8" Margin="0,16,0,0" Click="AddRouteButton_Click" />
          <TextBlock x:Name="RouteStatusText" Foreground="#52615E" Margin="0,12,0,0" TextWrapping="Wrap" />
          <Expander Header="{DynamicResource ManagePlaces}" Margin="0,20,0,0">
            <StackPanel Margin="0,10,0,0">
              <TextBlock Text="{DynamicResource PlaceNameLabel}" Foreground="#52615E" />
              <TextBox x:Name="PlaceNameInput" MaxLength="64" MinHeight="32" Margin="0,4,0,10" />
              <TextBlock Text="{DynamicResource PlaceStopCodeLabel}" Foreground="#52615E" />
              <TextBox x:Name="PlaceStopCodeInput" MaxLength="32" MinHeight="32" Margin="0,4,0,0" />
              <TextBlock Text="{DynamicResource PlaceStopCodeHelp}" Foreground="#52615E" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
              <Button Content="{DynamicResource SavePlace}" HorizontalAlignment="Left" Padding="12,7" Margin="0,10,0,0" Click="AddPlaceButton_Click" />
              <TextBlock x:Name="PlaceStatusText" Foreground="#52615E" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="#DCE5E2" BorderThickness="1" CornerRadius="6" Padding="20">
        <StackPanel>
          <TextBlock Text="{DynamicResource Monitoring}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="SelectedRouteText" Text="{DynamicResource WaitingForRoute}" Foreground="#52615E" Margin="0,16,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{DynamicResource PollingStatus}" Foreground="#147D70" Margin="0,24,0,0" />
        </StackPanel>
      </Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="{DynamicResource UserModeNotice}" Foreground="#52615E" Margin="0,18,0,0" />
  </Grid>
</Window>