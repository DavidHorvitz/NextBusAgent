<UserControl x:Class="BusPulse.Views.StopsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Border Background="White" BorderBrush="#DCE5E2" BorderThickness="1" CornerRadius="6" Padding="20">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{DynamicResource NearPlaceLabel}" Foreground="#52615E" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Places}" SelectedItem="{Binding SelectedAnchor}" DisplayMemberPath="Name"
                  MinWidth="180" MinHeight="32" AutomationProperties.Name="{DynamicResource NearPlaceLabel}" />
        <Button Content="{DynamicResource UseMyLocation}" Margin="8,0,0,0" Padding="12,5"
                Command="{Binding LoadCommand}" />
      </StackPanel>
      <StackPanel Grid.Row="1" Margin="0,12,0,8">
        <TextBlock Text="{Binding LocationText}" Foreground="#52615E" FontSize="12" />
        <TextBlock Text="{Binding StatusText}" Foreground="#52615E" TextWrapping="Wrap" Margin="0,4,0,0" />
        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Stops}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#E5ECEA" BorderThickness="0,0,0,1" Padding="0,8">
                <StackPanel>
                  <Button Command="{Binding DataContext.ToggleStopCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                          AutomationProperties.Name="{Binding Name}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Code}" Foreground="#52615E" FontSize="12" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding DistanceText}" Foreground="#147D70" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <StackPanel Margin="12,6,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ArrivalsStatus}" Foreground="#8A5A00" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Arrivals}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,3" ToolTip="{Binding Tooltip}">
                            <Grid.Style>
                              <Style TargetType="Grid">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsStale}" Value="True">
                                    <Setter Property="Opacity" Value="0.5" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="56" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#147D70" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                              <TextBlock Text="{Binding LineName}" Foreground="White" FontWeight="Bold" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Destination}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding EtaText}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" />
                            <Border Grid.Column="3" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="#FFF1D6" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                      <Setter Property="Background" Value="#D8F1EC" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="{Binding BadgeText}" FontSize="12" />
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
