<UserControl x:Class="BusPulse.Views.LinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BusPulse.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:CountToVisibilityConverter x:Key="CountToVisibility" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{DynamicResource LineFrom}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding Origins}" SelectedItem="{Binding SelectedOrigin}" DisplayMemberPath="DisplayName" MinWidth="200" MinHeight="32"
                        AutomationProperties.Name="{DynamicResource LineFrom}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{DynamicResource LineLoadLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
              <TextBox Text="{Binding LineName, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" MinWidth="120" MinHeight="32"
                       AutomationProperties.Name="{DynamicResource LineLoadLabel}" />
            </StackPanel>
            <Button Content="{DynamicResource LineLoad}" Command="{Binding LoadCommand}" VerticalAlignment="Bottom" Padding="14,7" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="{Binding PinText}" Command="{Binding TogglePinLineCommand}" VerticalAlignment="Bottom" Padding="12,7" />
          </StackPanel>
          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <ItemsControl ItemsSource="{Binding FavoriteLines}" Margin="0,12,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding}" Margin="0,0,6,6" Padding="10,4"
                        Command="{Binding DataContext.SelectFavoriteLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Visibility="{Binding Directions.Count, Converter={StaticResource CountToVisibility}}">
        <StackPanel>
          <TextBlock Text="{DynamicResource LineDirection}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding SelectedDirection}" DisplayMemberPath="Destination" MinHeight="32" HorizontalAlignment="Left" MinWidth="260"
                    AutomationProperties.Name="{DynamicResource LineDirection}" />
          <TextBlock Text="{Binding ScheduleNotice}" Foreground="{DynamicResource WarningTextBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Stops}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{DynamicResource MenuPlanRoute}"
                                Command="{Binding PlacementTarget.Tag.PlanRouteFromLineStopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Sequence}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOrigin}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Code}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontWeight="Bold" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
