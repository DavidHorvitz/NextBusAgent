<UserControl x:Class="BusPulse.Views.TripPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="White" BorderBrush="#DCE5E2" BorderThickness="1" CornerRadius="6" Padding="20">
    <StackPanel>
      <TextBlock Text="{DynamicResource Routes}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource StartPlaceLabel}" Foreground="#52615E" Margin="0,18,0,5" />
      <ComboBox ItemsSource="{Binding Places}" SelectedItem="{Binding SelectedStart}" DisplayMemberPath="Name" MinHeight="34"
                AutomationProperties.Name="{DynamicResource StartPlaceLabel}" />
      <TextBlock Text="{DynamicResource DestinationPlaceLabel}" Foreground="#52615E" Margin="0,14,0,5" />
      <ComboBox ItemsSource="{Binding Places}" SelectedItem="{Binding SelectedDestination}" DisplayMemberPath="Name" MinHeight="34"
                AutomationProperties.Name="{DynamicResource DestinationPlaceLabel}" />
      <TextBlock Text="{DynamicResource LineNameLabel}" Foreground="#52615E" Margin="0,14,0,5" />
      <TextBox Text="{Binding LineName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" MinHeight="32"
               AutomationProperties.Name="{DynamicResource LineNameLabel}" />
      <Button Content="{DynamicResource AddRoute}" Command="{Binding CheckRouteCommand}" HorizontalAlignment="Left" Padding="14,8" Margin="0,16,0,0" />
      <TextBlock Text="{Binding RouteSummary}" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap" />
      <TextBlock Text="{Binding StatusText}" Foreground="#52615E" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
