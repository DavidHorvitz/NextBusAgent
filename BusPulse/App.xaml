<Application x:Class="BusPulse.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- The strings dictionary must stay first: ResourceLocalizer swaps MergedDictionaries[0] on a language change. -->
        <ResourceDictionary Source="Resources/Strings.en.xaml" />
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>
      <!-- Brand colours; the theme service re-points AccentBrush for dark mode. -->
      <SolidColorBrush x:Key="AccentBrush" Color="#147D70" />
      <SolidColorBrush x:Key="LiveBadgeBrush" Color="#D8F1EC" />
      <SolidColorBrush x:Key="ScheduledBadgeBrush" Color="#FFF1D6" />
      <SolidColorBrush x:Key="WarningTextBrush" Color="#8A5A00" />
      <SolidColorBrush x:Key="ErrorTextBrush" Color="#B01E1E" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
