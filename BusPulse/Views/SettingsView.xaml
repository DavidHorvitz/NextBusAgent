<UserControl x:Class="BusPulse.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:BusPulse.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource CalendarLabel}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{Binding CalendarStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
          <TextBlock Text="{Binding SecretsSourceStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Command="{Binding ConnectCalendarCommand}" Padding="14,8"
                    AutomationProperties.Name="{DynamicResource CalendarConnect}"
                    Visibility="{Binding IsCalendarConnected, Converter={StaticResource InverseBoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="18" Margin="0,0,8,0" />
                <TextBlock Text="{DynamicResource CalendarConnect}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Content="{DynamicResource CalendarDisconnect}" Command="{Binding DisconnectCalendarCommand}" Margin="8,0,0,0" Padding="14,8"
                    Visibility="{Binding IsCalendarConnected, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource NotificationSettings}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{DynamicResource ThemeLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,14,0,4" />
          <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Name" Width="200" HorizontalAlignment="Left" MinHeight="32"
                    AutomationProperties.Name="{DynamicResource ThemeLabel}" />
          <TextBlock Text="{DynamicResource LanguageLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,14,0,4" />
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name" Width="160" HorizontalAlignment="Left" MinHeight="32"
                    AutomationProperties.Name="{DynamicResource LanguageLabel}" />
          <CheckBox Content="{DynamicResource NotificationsEnabledLabel}" IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" Margin="0,14,0,0"
                    AutomationProperties.Name="{DynamicResource NotificationsEnabledLabel}" />
          <TextBlock Text="{Binding SaveStatus}" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
          <TextBlock Text="{DynamicResource LeadTimeLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,14,0,4" />
          <ComboBox ItemsSource="{Binding LeadOptions}" SelectedItem="{Binding SelectedLeadMinutes}" Width="120" HorizontalAlignment="Left" MinHeight="32"
                    AutomationProperties.Name="{DynamicResource LeadTimeLabel}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{DynamicResource PollingLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,14,0,4" />
          <ComboBox ItemsSource="{Binding PollingOptions}" SelectedItem="{Binding SelectedPollingSeconds}" Width="120" HorizontalAlignment="Left" MinHeight="32"
                    AutomationProperties.Name="{DynamicResource PollingLabel}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="{DynamicResource SendTestNotification}" Command="{Binding SendTestNotificationCommand}" HorizontalAlignment="Left" Padding="12,6" Margin="0,16,0,0" />
          <TextBlock Text="{Binding TestStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource SavedPlacesQuick}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{DynamicResource HomePlaceLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,14,0,4" />
          <StackPanel Orientation="Horizontal">
            <ComboBox ItemsSource="{Binding Places}" SelectedItem="{Binding HomePlace}" DisplayMemberPath="Name" MinWidth="200" MinHeight="32"
                      AutomationProperties.Name="{DynamicResource HomePlaceLabel}" />
            <Button Content="{DynamicResource ClearPlace}" Command="{Binding ClearHomeCommand}" Margin="8,0,0,0" Padding="10,4" />
          </StackPanel>
          <TextBlock Text="{DynamicResource WorkPlaceLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,4" />
          <StackPanel Orientation="Horizontal">
            <ComboBox ItemsSource="{Binding Places}" SelectedItem="{Binding WorkPlace}" DisplayMemberPath="Name" MinWidth="200" MinHeight="32"
                      AutomationProperties.Name="{DynamicResource WorkPlaceLabel}" />
            <Button Content="{DynamicResource ClearPlace}" Command="{Binding ClearWorkCommand}" Margin="8,0,0,0" Padding="10,4" />
          </StackPanel>
          <Button Content="{DynamicResource ClearFavorites}" Command="{Binding ClearFavoritesCommand}" HorizontalAlignment="Left" Padding="12,6" Margin="0,16,0,0" />
          <TextBlock Text="{Binding FavoritesStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
          <Button Content="{DynamicResource ClearHistory}" Command="{Binding ClearHistoryCommand}" HorizontalAlignment="Left" Padding="12,6" Margin="0,12,0,0" />
          <TextBlock Text="{Binding HistoryStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource ManagePlaces}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
          <CheckBox Content="{DynamicResource AddressSearchSwitch}" IsChecked="{Binding AddressSearchEnabled, Mode=TwoWay}" Margin="0,14,0,0"
                    AutomationProperties.Name="{DynamicResource AddressSearchSwitch}" />
          <TextBlock Text="{DynamicResource AddressSearchPrivacy}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding AddressAttribution}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
          <TextBlock Text="{DynamicResource AddAddressTitle}" FontWeight="SemiBold" Margin="0,16,0,0" />
          <TextBlock Text="{DynamicResource AddressQueryLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,4" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding AddressQuery, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" MinHeight="32"
                     AutomationProperties.Name="{DynamicResource AddressQueryLabel}">
              <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding SearchAddressCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="{DynamicResource SearchAddress}" Command="{Binding SearchAddressCommand}" Padding="12,6" Margin="8,0,0,0"
                    AutomationProperties.Name="{DynamicResource SearchAddress}" />
          </Grid>
          <ListBox ItemsSource="{Binding AddressResults}" SelectedItem="{Binding SelectedAddress, Mode=TwoWay}" DisplayMemberPath="Label" MaxHeight="150" Margin="0,8,0,0"
                   AutomationProperties.Name="{DynamicResource AddressResultsLabel}" />
          <TextBlock Text="{DynamicResource AddressPlaceNameLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,4" />
          <TextBox Text="{Binding NewAddressPlaceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" MinHeight="32"
                   AutomationProperties.Name="{DynamicResource AddressPlaceNameLabel}">
            <TextBox.InputBindings>
              <KeyBinding Key="Return" Command="{Binding AddAddressPlaceCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button Content="{DynamicResource AddAddressPlace}" Command="{Binding AddAddressPlaceCommand}" HorizontalAlignment="Left" Padding="12,7" Margin="0,10,0,0"
                  AutomationProperties.Name="{DynamicResource AddAddressPlace}" />
          <TextBlock Text="{Binding AddressStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
          <Expander Header="{DynamicResource AdvancedStopCodeTitle}" Margin="0,16,0,0" AutomationProperties.Name="{DynamicResource AdvancedStopCodeTitle}">
            <StackPanel>
          <TextBlock Text="{DynamicResource PlaceNameLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,14,0,4" />
          <TextBox Text="{Binding NewPlaceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" MinHeight="32"
                   AutomationProperties.Name="{DynamicResource PlaceNameLabel}" />
          <TextBlock Text="{DynamicResource PlaceStopCodeLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,4" />
          <TextBox Text="{Binding NewPlaceStopCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" MinHeight="32"
                   AutomationProperties.Name="{DynamicResource PlaceStopCodeLabel}" />
          <TextBlock Text="{DynamicResource PlaceStopCodeHelp}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
          <Button Content="{DynamicResource SavePlace}" Command="{Binding AddPlaceCommand}" HorizontalAlignment="Left" Padding="12,7" Margin="0,10,0,0" />
          <TextBlock Text="{Binding PlaceStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>
          <ItemsControl ItemsSource="{Binding Places}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Margin="0,2">
                  <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding DisplayDetail, Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
        <StackPanel>
          <TextBlock Text="{DynamicResource ProviderStatusTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
          <Button Content="{DynamicResource CheckConnection}" Command="{Binding CheckConnectionCommand}" HorizontalAlignment="Left" Padding="12,7" Margin="0,12,0,0" />
          <ItemsControl ItemsSource="{Binding ProviderStatuses}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Margin="0,2">
                  <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Status, Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
