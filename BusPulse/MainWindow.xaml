<ui:FluentWindow x:Class="BusPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:BusPulse.Views"
        Title="BusPulse" Height="760" Width="980" MinHeight="640" MinWidth="440"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection}">
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}" />
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="0" />
    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="1" />
    <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="2" />
    <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="3" />
    <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="3" />
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="BusPulse" ShowMaximize="True" />
    <Grid Grid.Row="1" Margin="24,8,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="BusPulse" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock Text="{DynamicResource DashboardSubtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding LanguageButtonText}" Command="{Binding ToggleLanguageCommand}" Padding="14,7" Margin="0,0,8,0" />
          <Button Content="{DynamicResource MinimizeToTray}" Command="{Binding HideCommand}" Padding="14,7" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{DynamicResource ActiveProfile}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
            <TextBlock Text="{Binding ActiveProfile}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </StackPanel>
          <Button Grid.Column="1" Content="{Binding MuteButtonText}" Command="{Binding ToggleMuteCommand}" Padding="16,8" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Padding="0">
        <TabItem Header="{DynamicResource TabStops}" ToolTip="Ctrl+1">
          <views:StopsView DataContext="{Binding Stops}" Margin="0,12,0,0" />
        </TabItem>
        <TabItem Header="{DynamicResource TabTrip}" ToolTip="Ctrl+2">
          <views:TripPlannerView DataContext="{Binding TripPlanner}" Margin="0,12,0,0" />
        </TabItem>
        <TabItem Header="{DynamicResource TabLines}" ToolTip="Ctrl+3">
          <views:LinesView DataContext="{Binding Lines}" Margin="0,12,0,0" />
        </TabItem>
        <TabItem Header="{DynamicResource TabSettings}" ToolTip="Ctrl+4  ·  Ctrl+,">
          <views:SettingsView DataContext="{Binding SettingsTab}" Margin="0,12,0,0" />
        </TabItem>
      </TabControl>
      <TextBlock Grid.Row="3" Text="{DynamicResource UserModeNotice}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                 FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</ui:FluentWindow>
