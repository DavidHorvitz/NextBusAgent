<Application x:Class="BusPulse.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- The strings dictionary must stay first: ResourceLocalizer swaps MergedDictionaries[0] on a language change. -->
        <ResourceDictionary Source="Resources/Strings.en.xaml" />
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <!-- Design tokens and component styles (docs/DESIGN.md). IThemeService writes the Bp.* alias brushes and the older
             AccentBrush, HeaderGradientBrush, LiveBadgeBrush, ScheduledBadgeBrush, WarningTextBrush and ErrorTextBrush
             (now mapped onto the tokens) into this dictionary on every theme change. -->
        <ResourceDictionary Source="Themes/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
