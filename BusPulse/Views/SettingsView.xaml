<!--
  Content of the settings side panel (docs/DESIGN.md, layout rule 6). Flat sections with dividers, no cards; options that
  rarely change sit behind the "Advanced" expander, closed by default. Tokens and Bp.* styles only.
-->
<UserControl x:Class="BusPulse.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:BusPulse.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <Style x:Key="SectionDivider" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="0,16" />
      <Setter Property="Background" Value="{DynamicResource Bp.Border.Subtle}" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Bp.Type.Caption}">
      <Setter Property="Margin" Value="0,8,0,4" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,16,16">

      <!-- Appearance, language, alerts -->
      <TextBlock Text="{DynamicResource GeneralTitle}" Style="{StaticResource Bp.Type.Title}" />
      <TextBlock Text="{DynamicResource ThemeLabel}" Style="{StaticResource FieldLabel}" />
      <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" MinHeight="32"
                AutomationProperties.Name="{DynamicResource ThemeLabel}" />
      <TextBlock Text="{DynamicResource LanguageLabel}" Style="{StaticResource FieldLabel}" />
      <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" MinHeight="32"
                AutomationProperties.Name="{DynamicResource LanguageLabel}" />
      <CheckBox Content="{DynamicResource NotificationsEnabledLabel}" IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" Margin="0,16,0,0"
                AutomationProperties.Name="{DynamicResource NotificationsEnabledLabel}" />
      <TextBlock Text="{DynamicResource LeadTimeLabel}" Style="{StaticResource FieldLabel}" />
      <ComboBox ItemsSource="{Binding LeadOptions}" SelectedItem="{Binding SelectedLeadMinutes}" HorizontalAlignment="Left" Width="120" MinHeight="32"
                AutomationProperties.Name="{DynamicResource LeadTimeLabel}" />
      <TextBlock Text="{Binding SaveStatus}" Foreground="{DynamicResource Bp.Danger.11}" TextWrapping="Wrap" Margin="0,8,0,0" />

      <Border Style="{StaticResource SectionDivider}" />

      <!-- Saved places -->
      <TextBlock Text="{DynamicResource SavedPlacesQuick}" Style="{StaticResource Bp.Type.Title}" />
      <TextBlock Text="{DynamicResource HomePlaceLabel}" Style="{StaticResource FieldLabel}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox ItemsSource="{Binding Places}" SelectedItem="{Binding HomePlace}" DisplayMemberPath="Name" MinHeight="32"
                  AutomationProperties.Name="{DynamicResource HomePlaceLabel}" />
        <Button Grid.Column="1" Content="{DynamicResource ClearPlace}" Command="{Binding ClearHomeCommand}" Style="{StaticResource Bp.Button.Quiet}" Margin="8,0,0,0" />
      </Grid>
      <TextBlock Text="{DynamicResource WorkPlaceLabel}" Style="{StaticResource FieldLabel}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox ItemsSource="{Binding Places}" SelectedItem="{Binding WorkPlace}" DisplayMemberPath="Name" MinHeight="32"
                  AutomationProperties.Name="{DynamicResource WorkPlaceLabel}" />
        <Button Grid.Column="1" Content="{DynamicResource ClearPlace}" Command="{Binding ClearWorkCommand}" Style="{StaticResource Bp.Button.Quiet}" Margin="8,0,0,0" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Places}" Margin="0,8,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Margin="0,2" Style="{StaticResource Bp.Type.Body}" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding DisplayDetail, Mode=OneWay}" />
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{DynamicResource AddAddressTitle}" Style="{StaticResource Bp.Type.BodyStrong}" Margin="0,16,0,0" />
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Style="{StaticResource Bp.TextBox}" Text="{Binding AddressQuery, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"
                 AutomationProperties.Name="{DynamicResource AddressQueryLabel}">
          <TextBox.InputBindings>
            <KeyBinding Key="Return" Command="{Binding SearchAddressCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <Button Grid.Column="1" Content="{DynamicResource SearchAddress}" Command="{Binding SearchAddressCommand}" Style="{StaticResource Bp.Button.Secondary}" Margin="8,0,0,0"
                AutomationProperties.Name="{DynamicResource SearchAddress}" />
      </Grid>
      <ListBox ItemsSource="{Binding AddressResults}" SelectedItem="{Binding SelectedAddress, Mode=TwoWay}" DisplayMemberPath="Label" MaxHeight="150" Margin="0,8,0,0"
               ItemContainerStyle="{StaticResource Bp.SuggestionRow}" AutomationProperties.Name="{DynamicResource AddressResultsLabel}" />
      <TextBlock Text="{DynamicResource AddressPlaceNameLabel}" Style="{StaticResource FieldLabel}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Style="{StaticResource Bp.TextBox}" Text="{Binding NewAddressPlaceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                 AutomationProperties.Name="{DynamicResource AddressPlaceNameLabel}">
          <TextBox.InputBindings>
            <KeyBinding Key="Return" Command="{Binding AddAddressPlaceCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <Button Grid.Column="1" Content="{DynamicResource AddAddressPlace}" Command="{Binding AddAddressPlaceCommand}" Style="{StaticResource Bp.Button.Primary}" Margin="8,0,0,0"
                AutomationProperties.Name="{DynamicResource AddAddressPlace}" />
      </Grid>
      <TextBlock Text="{Binding AddressStatus}" Style="{StaticResource Bp.Type.Hint}" Margin="0,8,0,0" />

      <Border Style="{StaticResource SectionDivider}" />

      <!-- Calendar -->
      <TextBlock Text="{DynamicResource CalendarLabel}" Style="{StaticResource Bp.Type.Title}" />
      <TextBlock Text="{Binding CalendarStatus}" Style="{StaticResource Bp.Type.Hint}" Margin="0,8,0,0" />
      <Button Command="{Binding ConnectCalendarCommand}" Style="{StaticResource Bp.Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0"
              AutomationProperties.Name="{DynamicResource CalendarConnect}"
              Visibility="{Binding IsCalendarConnected, Converter={StaticResource InverseBoolToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="16" Margin="0,0,8,0" />
          <TextBlock Text="{DynamicResource CalendarConnect}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Content="{DynamicResource CalendarDisconnect}" Command="{Binding DisconnectCalendarCommand}" Style="{StaticResource Bp.Button.Secondary}"
              HorizontalAlignment="Left" Margin="0,8,0,0"
              Visibility="{Binding IsCalendarConnected, Converter={StaticResource BoolToVisibility}}" />

      <Border Style="{StaticResource SectionDivider}" />

      <!-- Advanced: closed by default. -->
      <Expander Header="{DynamicResource AdvancedTitle}" AutomationProperties.Name="{DynamicResource AdvancedTitle}" HorizontalAlignment="Stretch">
        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="{DynamicResource PollingLabel}" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding PollingOptions}" SelectedItem="{Binding SelectedPollingSeconds}" HorizontalAlignment="Left" Width="120" MinHeight="32"
                    AutomationProperties.Name="{DynamicResource PollingLabel}" />
          <Button Content="{DynamicResource SendTestNotification}" Command="{Binding SendTestNotificationCommand}" Style="{StaticResource Bp.Button.Secondary}"
                  HorizontalAlignment="Left" Margin="0,16,0,0" />
          <TextBlock Text="{Binding TestStatus}" Style="{StaticResource Bp.Type.Hint}" Margin="0,8,0,0" />

          <CheckBox Content="{DynamicResource AddressSearchSwitch}" IsChecked="{Binding AddressSearchEnabled, Mode=TwoWay}" Margin="0,16,0,0"
                    AutomationProperties.Name="{DynamicResource AddressSearchSwitch}" />
          <TextBlock Text="{DynamicResource AddressSearchPrivacy}" Style="{StaticResource Bp.Type.Hint}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding AddressAttribution}" Style="{StaticResource Bp.Type.Hint}" Margin="0,4,0,0" />

          <TextBlock Text="{DynamicResource AdvancedStopCodeTitle}" Style="{StaticResource Bp.Type.BodyStrong}" Margin="0,16,0,0" />
          <TextBlock Text="{DynamicResource PlaceNameLabel}" Style="{StaticResource FieldLabel}" />
          <TextBox Style="{StaticResource Bp.TextBox}" Text="{Binding NewPlaceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                   AutomationProperties.Name="{DynamicResource PlaceNameLabel}" />
          <TextBlock Text="{DynamicResource PlaceStopCodeLabel}" Style="{StaticResource FieldLabel}" />
          <TextBox Style="{StaticResource Bp.TextBox}" Text="{Binding NewPlaceStopCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="32"
                   AutomationProperties.Name="{DynamicResource PlaceStopCodeLabel}" />
          <TextBlock Text="{DynamicResource PlaceStopCodeHelp}" Style="{StaticResource Bp.Type.Hint}" Margin="0,4,0,0" />
          <Button Content="{DynamicResource SavePlace}" Command="{Binding AddPlaceCommand}" Style="{StaticResource Bp.Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0" />
          <TextBlock Text="{Binding PlaceStatus}" Style="{StaticResource Bp.Type.Hint}" Margin="0,8,0,0" />

          <Button Content="{DynamicResource ClearFavorites}" Command="{Binding ClearFavoritesCommand}" Style="{StaticResource Bp.Button.Destructive}" HorizontalAlignment="Left" Margin="0,16,0,0" />
          <TextBlock Text="{Binding FavoritesStatus}" Style="{StaticResource Bp.Type.Hint}" Margin="0,8,0,0" />
          <Button Content="{DynamicResource ClearHistory}" Command="{Binding ClearHistoryCommand}" Style="{StaticResource Bp.Button.Destructive}" HorizontalAlignment="Left" Margin="0,8,0,0" />
          <TextBlock Text="{Binding HistoryStatus}" Style="{StaticResource Bp.Type.Hint}" Margin="0,8,0,0" />

          <TextBlock Text="{DynamicResource ProviderStatusTitle}" Style="{StaticResource Bp.Type.BodyStrong}" Margin="0,16,0,0" />
          <Button Content="{DynamicResource CheckConnection}" Command="{Binding CheckConnectionCommand}" Style="{StaticResource Bp.Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0" />
          <ItemsControl ItemsSource="{Binding ProviderStatuses}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Margin="0,2" Style="{StaticResource Bp.Type.Body}" TextWrapping="Wrap">
                  <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Status, Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{Binding SecretsSourceStatus}" Style="{StaticResource Bp.Type.Hint}" Margin="0,16,0,0" />
          <TextBlock Text="{DynamicResource UserModeNotice}" Style="{StaticResource Bp.Type.Hint}" Margin="0,8,0,0" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
