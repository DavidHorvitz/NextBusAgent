<ui:FluentWindow x:Class="BusPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:BusPulse.Views"
        Title="BusPulse" Height="760" Width="980" MinHeight="640" MinWidth="440"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Bp.Font}"
        FlowDirection="{Binding FlowDirection}">
  <!-- Mica is requested above; WPF-UI falls back to the plain window background where Mica is unavailable (Windows 10). -->
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}" />
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="0" />
    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="1" />
    <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="2" />
    <KeyBinding Key="D4" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
    <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CloseSettingsCommand}" />
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="BusPulse" ShowMaximize="True">
      <ui:TitleBar.TrailingContent>
        <Button Style="{StaticResource Bp.Button.Icon}" Command="{Binding ToggleSettingsCommand}" Margin="0,0,8,0"
                ToolTip="{DynamicResource TabSettings}" AutomationProperties.Name="{DynamicResource TabSettings}">
          <ui:SymbolIcon Symbol="Settings24" FontSize="20" />
        </Button>
      </ui:TitleBar.TrailingContent>
    </ui:TitleBar>
    <views:ShellView Grid.Row="1" />
  </Grid>
</ui:FluentWindow>
