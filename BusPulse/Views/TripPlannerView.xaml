<UserControl x:Class="BusPulse.Views.TripPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BusPulse.Views"
             xmlns:controls="clr-namespace:BusPulse.Views.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:IndexToBoolConverter x:Key="IndexToBool" />
    <views:CountToVisibilityConverter x:Key="CountToVisibility" />
    <views:OperatorBrushConverter x:Key="OperatorBrush" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{DynamicResource StartPlaceLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedOrigin}" DisplayMemberPath="DisplayName" MinHeight="34"
                        AutomationProperties.Name="{DynamicResource StartPlaceLabel}" />
            </StackPanel>
            <Button Grid.Column="1" Content="⇄" Command="{Binding SwapCommand}" Margin="8,20,8,0" Padding="10,4" VerticalAlignment="Center"
                    ToolTip="{DynamicResource SwapRoutes}" AutomationProperties.Name="{DynamicResource SwapRoutes}" />
            <StackPanel Grid.Column="2">
              <TextBlock Text="{DynamicResource DestinationPlaceLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedDestination}" DisplayMemberPath="DisplayName" MinHeight="34"
                        AutomationProperties.Name="{DynamicResource DestinationPlaceLabel}" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{DynamicResource GoHome}" Command="{Binding GoHomeCommand}" Padding="12,5" Margin="0,0,8,0"
                    Visibility="{Binding HasHome, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{DynamicResource GoWork}" Command="{Binding GoWorkCommand}" Padding="12,5"
                    Visibility="{Binding HasWork, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <TextBlock Text="{DynamicResource DestinationSearch}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,4" />
          <TextBox x:Name="SearchBox" Text="{Binding DestinationQuery, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" MaxLength="64"
                   AutomationProperties.Name="{DynamicResource DestinationSearch}" PreviewKeyDown="SearchBox_PreviewKeyDown" />
          <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" DisplayMemberPath="DisplayName" MaxHeight="150"
                   Visibility="{Binding Suggestions.Count, Converter={StaticResource CountToVisibility}}"
                   PreviewKeyDown="SuggestionList_PreviewKeyDown" MouseDoubleClick="SuggestionList_MouseDoubleClick"
                   AutomationProperties.Name="{DynamicResource DestinationSearch}" />
          <TextBlock Text="{Binding RouteSummary}" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <RadioButton Content="{DynamicResource ModeNow}" GroupName="TripMode" Margin="0,0,16,0"
                         IsChecked="{Binding SelectedModeIndex, Converter={StaticResource IndexToBool}, ConverterParameter=0}" />
            <RadioButton Content="{DynamicResource ModeDepartAt}" GroupName="TripMode" Margin="0,0,16,0"
                         IsChecked="{Binding SelectedModeIndex, Converter={StaticResource IndexToBool}, ConverterParameter=1}" />
            <RadioButton Content="{DynamicResource ModeArriveBy}" GroupName="TripMode"
                         IsChecked="{Binding SelectedModeIndex, Converter={StaticResource IndexToBool}, ConverterParameter=2}" />
          </StackPanel>
          <controls:TimeWheelPicker Value="{Binding TargetTime, Mode=TwoWay}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Visibility="{Binding IsTimeSelectable, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{DynamicResource PreferredLineLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,4" />
          <TextBox Text="{Binding LineName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" MinHeight="32" Width="160" HorizontalAlignment="Left"
                   AutomationProperties.Name="{DynamicResource PreferredLineLabel}" />
          <Button Content="{DynamicResource PlanTrip}" Command="{Binding PlanCommand}" HorizontalAlignment="Left" Padding="16,8" Margin="0,14,0,0" IsDefault="True" />
          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Options}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,8" ToolTip="{Binding Tooltip}">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsStale}" Value="True">
                      <Setter Property="Opacity" Value="0.55" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                  <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" Background="{Binding Operator, Converter={StaticResource OperatorBrush}}">
                    <TextBlock Text="{Binding Line}" Foreground="White" FontWeight="Bold" FontSize="16" />
                  </Border>
                  <TextBlock Text="{Binding Operator}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal">
                    <controls:DirectionArrow Bearing="{Binding BearingDegrees}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding RouteText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding WalkText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding BusText}" FontSize="12" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ArriveText}" FontSize="12" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding LeaveText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding LeaveAtText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Border CornerRadius="8" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource ScheduledBadgeBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource LiveBadgeBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding BadgeText}" FontSize="12" />
                    </Border>
                    <Button Padding="8,2" ToolTip="{DynamicResource RemindMe}" AutomationProperties.Name="{DynamicResource RemindMe}"
                            Command="{Binding DataContext.ToggleReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                          <Setter Property="Content" Value="🔔" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWatched}" Value="True">
                              <Setter Property="Content" Value="🔔 ✓" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
