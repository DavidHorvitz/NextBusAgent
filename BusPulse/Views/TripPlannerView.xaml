<UserControl x:Class="BusPulse.Views.TripPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:BusPulse.Views"
             xmlns:controls="clr-namespace:BusPulse.Views.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:IndexToBoolConverter x:Key="IndexToBool" />
    <views:CountToVisibilityConverter x:Key="CountToVisibility" />
    <views:OperatorBrushConverter x:Key="OperatorBrush" />
    <!-- A suggestion list is a plain stack of rows under its box: no border or card of its own. -->
    <Style x:Key="SuggestionList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MaxHeight" Value="280" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <DataTemplate x:Key="SuggestionTemplate">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Bp.Type.Caption}" Margin="12,0,0,0" VerticalAlignment="Center"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
      </Grid>
    </DataTemplate>
    <Style x:Key="HiddenWhenEmptyText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12"
              Visibility="{Binding CalendarSuggestions.Count, Converter={StaticResource CountToVisibility}}">
        <StackPanel>
          <TextBlock Text="{DynamicResource CalendarSuggestionsTitle}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding CalendarSuggestions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding StartText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,8,0" />
                      <TextBlock Text="{Binding PlaceName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="1" Content="{DynamicResource CalendarSuggestionUse}" Padding="12,5" Margin="12,0,0,0" VerticalAlignment="Center"
                          Command="{Binding DataContext.UseCalendarSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12">
        <StackPanel>
          <!-- Origin: free text. Suggestions: my location, saved places, calendar, recent, stops, addresses (DESIGN.md, suggestion row). -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource StartPlaceLabel}" Style="{StaticResource Bp.Type.Caption}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource Bp.Button.Icon}" Command="{Binding SwapCommand}"
                    ToolTip="{DynamicResource SwapRoutes}" AutomationProperties.Name="{DynamicResource SwapRoutes}">
              <ui:SymbolIcon Symbol="ArrowSwap24" />
            </Button>
          </Grid>
          <Grid Margin="0,4,0,0">
            <TextBox x:Name="OriginSearchBox" Style="{StaticResource Bp.TextBox}" Text="{Binding OriginQuery, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="64" Padding="8,4,8,4" AutomationProperties.Name="{DynamicResource StartPlaceLabel}"
                     PreviewKeyDown="OriginSearchBox_PreviewKeyDown" GotKeyboardFocus="OriginSearchBox_GotKeyboardFocus"
                     LostKeyboardFocus="OriginSearchBox_LostKeyboardFocus" />
            <TextBlock Text="{DynamicResource OriginPlaceholder}" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="10,0,10,0" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Bp.Type.Caption}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding OriginQuery}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Margin="4,0,4,1" AutomationProperties.Name="{DynamicResource SearchingAddress}"
                         Visibility="{Binding IsOriginSearching, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
          <ListBox x:Name="OriginSuggestionList" Style="{StaticResource SuggestionList}" ItemTemplate="{StaticResource SuggestionTemplate}"
                   ItemContainerStyle="{StaticResource Bp.SuggestionRow}" ItemsSource="{Binding OriginSuggestions}"
                   SelectedItem="{Binding HighlightedOrigin, Mode=TwoWay}" Focusable="False"
                   Visibility="{Binding OriginSuggestions.Count, Converter={StaticResource CountToVisibility}}"
                   PreviewMouseLeftButtonUp="OriginSuggestionList_PreviewMouseLeftButtonUp"
                   AutomationProperties.Name="{DynamicResource StartPlaceLabel}" />
          <TextBlock Text="{DynamicResource NoResultsLine}" Style="{StaticResource Bp.Type.Hint}" Margin="8,6,8,0"
                     Visibility="{Binding OriginNoResults, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding OriginSearchMessage}" Style="{StaticResource HiddenWhenEmptyText}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="{DynamicResource SavePlace}" Command="{Binding SaveOriginCommand}" Style="{StaticResource Bp.Button.Quiet}" Margin="0,0,8,0"
                    Visibility="{Binding CanSaveOrigin, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{DynamicResource SaveAsHome}" Command="{Binding SaveOriginCommand}" CommandParameter="home" Style="{StaticResource Bp.Button.Quiet}" Margin="0,0,8,0"
                    Visibility="{Binding CanSaveOrigin, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{DynamicResource SaveAsWork}" Command="{Binding SaveOriginCommand}" CommandParameter="work" Style="{StaticResource Bp.Button.Quiet}"
                    Visibility="{Binding CanSaveOrigin, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <TextBlock Text="{DynamicResource DestinationPlaceLabel}" Style="{StaticResource Bp.Type.Caption}" Margin="0,16,0,0" />
          <Grid Margin="0,4,0,0">
            <TextBox x:Name="SearchBox" Style="{StaticResource Bp.TextBox}" Text="{Binding DestinationQuery, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="64" Padding="8,4,8,4" AutomationProperties.Name="{DynamicResource DestinationPlaceLabel}"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                     LostKeyboardFocus="SearchBox_LostKeyboardFocus" />
            <TextBlock Text="{DynamicResource DestinationPlaceholder}" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="10,0,10,0" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Bp.Type.Caption}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DestinationQuery}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Margin="4,0,4,1" AutomationProperties.Name="{DynamicResource SearchingAddress}"
                         Visibility="{Binding IsDestinationSearching, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
          <ListBox x:Name="SuggestionList" Style="{StaticResource SuggestionList}" ItemTemplate="{StaticResource SuggestionTemplate}"
                   ItemContainerStyle="{StaticResource Bp.SuggestionRow}" ItemsSource="{Binding Suggestions}"
                   SelectedItem="{Binding HighlightedDestination, Mode=TwoWay}" Focusable="False"
                   Visibility="{Binding Suggestions.Count, Converter={StaticResource CountToVisibility}}"
                   PreviewMouseLeftButtonUp="SuggestionList_PreviewMouseLeftButtonUp"
                   AutomationProperties.Name="{DynamicResource DestinationPlaceLabel}" />
          <TextBlock Text="{DynamicResource NoResultsLine}" Style="{StaticResource Bp.Type.Hint}" Margin="8,6,8,0"
                     Visibility="{Binding DestinationNoResults, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding DestinationSearchMessage}" Style="{StaticResource HiddenWhenEmptyText}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="{DynamicResource GoHome}" Command="{Binding GoHomeCommand}" Style="{StaticResource Bp.Button.Secondary}" Margin="0,0,8,0"
                    Visibility="{Binding HasHome, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{DynamicResource GoWork}" Command="{Binding GoWorkCommand}" Style="{StaticResource Bp.Button.Secondary}" Margin="0,0,8,0"
                    Visibility="{Binding HasWork, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{DynamicResource SavePlace}" Command="{Binding SaveDestinationCommand}" Style="{StaticResource Bp.Button.Quiet}" Margin="0,0,8,0"
                    Visibility="{Binding CanSaveDestination, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{DynamicResource SaveAsHome}" Command="{Binding SaveDestinationCommand}" CommandParameter="home" Style="{StaticResource Bp.Button.Quiet}" Margin="0,0,8,0"
                    Visibility="{Binding CanSaveDestination, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{DynamicResource SaveAsWork}" Command="{Binding SaveDestinationCommand}" CommandParameter="work" Style="{StaticResource Bp.Button.Quiet}"
                    Visibility="{Binding CanSaveDestination, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <TextBlock Text="{Binding RouteSummary}" Style="{StaticResource Bp.Type.BodyStrong}" Margin="0,16,0,0" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <RadioButton Content="{DynamicResource ModeNow}" GroupName="TripMode" Margin="0,0,16,0"
                         IsChecked="{Binding SelectedModeIndex, Converter={StaticResource IndexToBool}, ConverterParameter=0}" />
            <RadioButton Content="{DynamicResource ModeDepartAt}" GroupName="TripMode" Margin="0,0,16,0"
                         IsChecked="{Binding SelectedModeIndex, Converter={StaticResource IndexToBool}, ConverterParameter=1}" />
            <RadioButton Content="{DynamicResource ModeArriveBy}" GroupName="TripMode"
                         IsChecked="{Binding SelectedModeIndex, Converter={StaticResource IndexToBool}, ConverterParameter=2}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                      Visibility="{Binding IsDateSelectable, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{DynamicResource DateLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Content="{DynamicResource DateToday}" Command="{Binding SelectTodayCommand}" Padding="12,5" Margin="0,0,8,0"
                    AutomationProperties.Name="{DynamicResource DateToday}" />
            <Button Content="{DynamicResource DateTomorrow}" Command="{Binding SelectTomorrowCommand}" Padding="12,5" Margin="0,0,8,0"
                    AutomationProperties.Name="{DynamicResource DateTomorrow}" />
            <DatePicker DisplayDateStart="{Binding MinDate, Mode=OneWay}" DisplayDateEnd="{Binding MaxDate, Mode=OneWay}" SelectedDate="{Binding TargetDate, Mode=TwoWay}"
                        MinWidth="140" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource DateLabel}" />
          </StackPanel>
          <TextBlock Text="{Binding DateNotice}" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Visibility="{Binding HasDateNotice, Converter={StaticResource BoolToVisibility}}" />
          <controls:TimeWheelPicker Value="{Binding TargetTime, Mode=TwoWay}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Visibility="{Binding IsTimeSelectable, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{DynamicResource PreferredLineLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,4" />
          <TextBox Text="{Binding LineName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" MinHeight="32" Width="160" HorizontalAlignment="Left"
                   AutomationProperties.Name="{DynamicResource PreferredLineLabel}" />
          <Button Content="{DynamicResource PlanTrip}" Command="{Binding PlanCommand}" HorizontalAlignment="Left" Padding="16,8" Margin="0,14,0,0" IsDefault="True" />
          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Options}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,8" ToolTip="{Binding Tooltip}">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsStale}" Value="True">
                      <Setter Property="Opacity" Value="0.55" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                  <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" Background="{Binding Operator, Converter={StaticResource OperatorBrush}}">
                    <TextBlock Text="{Binding Line}" Foreground="White" FontWeight="Bold" FontSize="16" />
                  </Border>
                  <TextBlock Text="{Binding Operator}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal">
                    <controls:DirectionArrow Bearing="{Binding BearingDegrees}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding RouteText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding WalkText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding BusText}" FontSize="12" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ArriveText}" FontSize="12" />
                  </StackPanel>
                  <TextBlock Text="{Binding DateText}" FontSize="12" Style="{StaticResource HiddenWhenEmptyText}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding LeaveText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding LeaveAtText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Border CornerRadius="8" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource ScheduledBadgeBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource LiveBadgeBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding BadgeText}" FontSize="12" />
                    </Border>
                    <Button Padding="8,2" ToolTip="{DynamicResource RemindMe}" AutomationProperties.Name="{DynamicResource RemindMe}"
                            Command="{Binding DataContext.ToggleReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                          <Setter Property="Content" Value="🔔" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWatched}" Value="True">
                              <Setter Property="Content" Value="🔔 ✓" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
