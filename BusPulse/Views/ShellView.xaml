<!--
  The application shell below the title bar: navigation (stops, trip planner, lines) and the settings side panel.
  Only Bp.* tokens and Theme.xaml styles. The navigation pane sits at the start edge (right in Hebrew), the settings panel
  at the end edge, so both mirror with FlowDirection.
-->
<UserControl x:Class="BusPulse.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:BusPulse.Views"
             xmlns:controls="clr-namespace:BusPulse.Views.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Grid>
    <ui:NavigationView x:Name="Nav" PaneDisplayMode="Left" IsPaneToggleVisible="False" IsBackButtonVisible="Collapsed"
                       OpenPaneLength="168" FrameMargin="0" Transition="None">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="{DynamicResource TabStops}" Icon="{ui:SymbolIcon Location24}"
                               TargetPageType="{x:Type views:StopsView}" ToolTip="Ctrl+1" />
        <ui:NavigationViewItem Content="{DynamicResource TabTrip}" Icon="{ui:SymbolIcon Directions24}"
                               TargetPageType="{x:Type views:TripPlannerView}" ToolTip="Ctrl+2" />
        <ui:NavigationViewItem Content="{DynamicResource TabLines}" Icon="{ui:SymbolIcon TextBulletListLtr24}"
                               TargetPageType="{x:Type views:LinesView}" ToolTip="Ctrl+3" />
      </ui:NavigationView.MenuItems>
    </ui:NavigationView>

    <!-- Scrim: clicking outside the panel closes it. -->
    <Border Background="{DynamicResource Bp.Bg.App}" Opacity="0.6"
            Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
      <Border.InputBindings>
        <MouseBinding MouseAction="LeftClick" Command="{Binding CloseSettingsCommand}" />
      </Border.InputBindings>
    </Border>

    <Grid x:Name="SettingsPanel" Width="400" HorizontalAlignment="Right" Background="{DynamicResource Bp.Bg.Subtle}"
          controls:Motion.FadeInOnShow="True"
          Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource Bp.Border.Subtle}" />
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="16,8,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource TabSettings}" Style="{StaticResource Bp.Type.Title}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Style="{StaticResource Bp.Button.Icon}" Command="{Binding CloseSettingsCommand}"
                  ToolTip="{DynamicResource SettingsClose}" AutomationProperties.Name="{DynamicResource SettingsClose}">
            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
          </Button>
        </Grid>
        <views:SettingsView Grid.Row="1" DataContext="{Binding SettingsTab}" Margin="16,0,0,0" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
