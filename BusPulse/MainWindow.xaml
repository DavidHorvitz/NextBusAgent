<Window x:Class="BusPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BusPulse.Views"
        Title="BusPulse" Height="700" Width="960" MinHeight="600" MinWidth="420"
        Background="{DynamicResource SurfaceBrush}" WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection}">
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="0" />
    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="1" />
    <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="2" />
    <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="3" />
    <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding SelectTabCommand}" CommandParameter="3" />
  </Window.InputBindings>
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="BusPulse" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource DashboardSubtitle}" Foreground="#52615E" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="{Binding LanguageButtonText}" Command="{Binding ToggleLanguageCommand}" Padding="12,7" Margin="0,0,8,0" />
        <Button Content="{DynamicResource MinimizeToTray}" Command="{Binding HideCommand}" Padding="12,7" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="White" BorderBrush="#DCE5E2" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{DynamicResource ActiveProfile}" Foreground="#52615E" />
          <TextBlock Text="{Binding ActiveProfile}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding MuteButtonText}" Command="{Binding ToggleMuteCommand}" Padding="14,8" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
      <TabItem Header="{DynamicResource TabStops}">
        <views:StopsView DataContext="{Binding Stops}" Margin="0,12,0,0" />
      </TabItem>
      <TabItem Header="{DynamicResource TabTrip}">
        <views:TripPlannerView DataContext="{Binding TripPlanner}" Margin="0,12,0,0" />
      </TabItem>
      <TabItem Header="{DynamicResource TabLines}">
        <views:LinesView DataContext="{Binding Lines}" Margin="0,12,0,0" />
      </TabItem>
      <TabItem Header="{DynamicResource TabSettings}">
        <views:SettingsView DataContext="{Binding SettingsTab}" Margin="0,12,0,0" />
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="3" Text="{DynamicResource UserModeNotice}" Foreground="#52615E" Margin="0,18,0,0" TextWrapping="Wrap" />
  </Grid>
</Window>
